{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/product/page",
    "app/product/(backup)/page",
    "app/(backup)/productStore/page",
    "app/cart/(backup)/page",
    "components/(backup)/ShowUserCartFormDBTest",
    "components/(backup)/ShowUserCartFormDBSideTest",
    "components/(backup)/ShowUserCartFormDBSide",
    "components/(backup)/ShowUserCartFormDB"
  ],
  "exclude": ["node_modules"]
}
